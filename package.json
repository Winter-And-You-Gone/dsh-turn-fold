{
  "name": "@winteries/dsh-turn-fold",
  "version": "0.6.0",
  "type": "module",
  "main": "index.js",
  "description": "Enhances DeepSeek Harness native folding with a richer turn bar (poker icon, duration, TTFT, tokens, tok/s, cache hit, running status), a pure-CSS poker skin for official step groups and plugin-owned appearance settings. DSH owns all folding semantics; this plugin only enhances the UI. Zero source patches.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Winter-And-You-Gone/dsh-turn-fold.git"
  },
  "homepage": "https://github.com/Winter-And-You-Gone/dsh-turn-fold#readme",
  "bugs": {
    "url": "https://github.com/Winter-And-You-Gone/dsh-turn-fold/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=20.3",
    "dsh": ">=0.1.7-rc.1 <=0.2.0-rc.2"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node --max-old-space-size=4096 --max-semi-space-size=64 --test --test-isolation=none --test-force-exit \"tests/*.test.mjs\"",
    "sync:icons": "node scripts/sync-icons.mjs --inject",
    "sync:step-anim": "node scripts/sync-step-anim.mjs",
    "icons:check": "node scripts/sync-icons.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "fold",
    "turn-process",
    "poker",
    "metrics"
  ],
  "files": [
    "index.js",
    "client.js",
    "icons/default.json",
    "assets/dsh-turn-fold-customize-icons.md",
    "scripts/sync-icons.mjs",
    "scripts/sync-step-anim.mjs",
    "cordis.patch.yml",
    "install.ps1",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs/images/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
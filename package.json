{
  "name": "@winteries/dsh-turn-fold",
  "version": "0.3.1",
  "type": "module",
  "main": "index.js",
  "description": "将工具调用与 Think 段自动折叠为步骤折叠栏：运行中动态显示正在执行的工具与思考内容，闭合后按工具类型汇总。回合结束后整回合收拢为一个回合折叠栏，只保留最终总结正文，实时显示耗时与 token 消耗，并标注回合序号与结束状态，支持点击展开查看完整过程。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Winter-And-You-Gone/dsh-turn-fold.git"
  },
  "homepage": "https://github.com/Winter-And-You-Gone/dsh-turn-fold#readme",
  "bugs": {
    "url": "https://github.com/Winter-And-You-Gone/dsh-turn-fold/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node --test --test-isolation=none \"tests/*.test.mjs\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "collapse",
    "fold",
    "think",
    "tool-call"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs/images/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
